# Finance Seer Environment Configuration
# Copy to .env and fill in real values. Never commit .env.

# ── LLM (GX10 vLLM, OpenAI-compatible) ──────────────────────────────────
# Current serving stack: vLLM on DGX Spark GX10, model qwen3.8-flash-next.
# LM Studio and Ollama are RETIRED — do not point these at :1234 or :11434.
OPENAI_API_URL=http://192.168.10.163:8000/v1
AI_MODEL=qwen3.8-flash-next
# vLLM needs no real key; keep a placeholder for client libs that require one.
OPENAI_API_KEY=***

# ── Market data ─────────────────────────────────────────────────────────
FINNHUB_API_KEY=your_f…here
TAVILY_API_KEY=your_t…here

# ── Telegram alerts ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=***
TELEGRAM_CHAT_ID=your_chat_id

# ── IBKR (paper trading is the mandatory default) ───────────────────────
# From Docker, reach the Windows host via host.docker.internal (TWS/Gateway
# must have ActiveXML/API enabled). Port 4002 = paper, 4001 = live.
IBKR_HOST=host.docker.internal
IBKR_PORT=4002

# ── Database ────────────────────────────────────────────────────────────
# SQLite file path (auto-created, relative to project root)
DATABASE_URL=sqlite:./data/finance.db
